# Application
APP_ENV=development
SECRET_KEY=change-me-in-production

# API (optional overrides)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# PostgreSQL (use postgresql+psycopg for SQLAlchemy + psycopg3)
DATABASE_URL=postgresql+psycopg://xianxia:xianxia@localhost:5432/xianxia_db

# Redis (DB index optional)
REDIS_URL=redis://localhost:6379/0

# OpenAI (chat + embeddings for Chroma)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chroma persistence (relative to project root by default)
CHROMA_PERSIST_DIR=data/chroma

# Streamlit → FastAPI base URL
XIANXIA_API_BASE=http://127.0.0.1:8000
