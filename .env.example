# Application
APP_ENV=development

# API (optional overrides)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# PostgreSQL (use postgresql+psycopg for SQLAlchemy + psycopg3)
DATABASE_URL=postgresql+psycopg://xianxia:xianxia@localhost:5432/xianxia_db

# Redis (DB index optional)
REDIS_URL=redis://localhost:6379/0

# Session memory: rolling summary + recent turns (optional)
# MEMORY_RECENT_TURNS_MAX=10
# MEMORY_SUMMARY_MAX_CHARS=1200
# MEMORY_MAX_TOKENS=4000

# LLM (OpenAI-compatible API — supports DeepSeek / OpenAI / any compatible provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chroma persistence (relative to project root by default)
CHROMA_PERSIST_DIR=data/chroma

# Streamlit → FastAPI base URL
XIANXIA_API_BASE=http://127.0.0.1:8000
